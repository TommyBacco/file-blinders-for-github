{
  "manifest_version": 3,
  "name": "File Blinders for GitHub",
  "version": "1.1.0",
  "description": "Reviews one half of a GitHub PR: marks test files (or implementation files, toggleable) as Viewed so the other half stays in view. No network access.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{72ec9cd0-adc9-4036-80cf-98724d2b0504}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "action": {
    "default_title": "File Blinders for GitHub — pick which files to hide",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
